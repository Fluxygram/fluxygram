{
  "name": "@fluxygram/docusaurus",
  "version": "0.3.0",
  "description": "Fluxygram for Docusaurus: animated diagrams in your docs and blog.",
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "fluxygram",
    "diagram",
    "animation"
  ],
  "type": "module",
  "license": "MIT",
  "homepage": "https://docs.fluxygram.app/guides/integrations/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fluxygram/fluxygram.git",
    "directory": "packages/docusaurus"
  },
  "bugs": {
    "url": "https://github.com/Fluxygram/fluxygram/issues"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/client.ts --format esm --dts --clean --target es2022"
  },
  "dependencies": {
    "@fluxygram/element": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  }
}
