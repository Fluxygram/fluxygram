{
  "name": "@fluxygram/core",
  "version": "0.1.2",
  "description": "Fluxygram's diagram format: validation, automatic layout and motion grammar. No framework, no DOM.",
  "keywords": [
    "diagram",
    "animation",
    "flowchart",
    "architecture",
    "json",
    "fluxygram"
  ],
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "homepage": "https://fluxygram.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fluxygram/fluxygram.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Fluxygram/fluxygram/issues"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --target es2022"
  }
}
