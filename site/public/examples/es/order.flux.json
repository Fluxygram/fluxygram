{
  "$schema": "/schema/v1.json",
  "type": "flow",
  "title": "Cómo se procesa un pedido",
  "nodes": [
    {
      "id": "start",
      "label": "Pedido recibido",
      "kind": "start",
      "icon": "cart"
    },
    {
      "id": "stock",
      "label": "¿Hay stock?",
      "kind": "decision"
    },
    {
      "id": "notify",
      "label": "Avisar al cliente",
      "description": "fecha de reposición",
      "icon": "mail"
    },
    {
      "id": "pay",
      "label": "Cobrar",
      "description": "tarjeta o transferencia",
      "icon": "card"
    },
    {
      "id": "ship",
      "label": "Preparar envío",
      "icon": "package"
    },
    {
      "id": "done",
      "label": "Entregado",
      "kind": "end",
      "icon": "check"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": "start",
      "to": "stock",
      "carries": "pedido"
    },
    {
      "id": "no",
      "from": "stock",
      "to": "notify",
      "label": "no"
    },
    {
      "id": "yes",
      "from": "stock",
      "to": "pay",
      "label": "sí"
    },
    {
      "id": "e4",
      "from": "pay",
      "to": "ship",
      "carries": "$"
    },
    {
      "id": "e5",
      "from": "ship",
      "to": "done"
    }
  ],
  "steps": [
    {
      "show": [
        "start"
      ],
      "caption": "Llega un pedido",
      "notes": "Empieza por el cliente: acaba de llegar un pedido desde la tienda."
    },
    {
      "show": [
        "e1"
      ],
      "flow": "e1",
      "state": {
        "stock": "pending"
      },
      "caption": "Se revisa el inventario",
      "notes": "Antes de cobrar revisamos el almacén. Tarda un momento, por eso el spinner."
    },
    {
      "show": [
        "no"
      ],
      "flow": "no",
      "state": {
        "stock": "warning",
        "no": "error",
        "notify": "error"
      },
      "caption": "Sin stock: se avisa al cliente",
      "notes": "Primero el peor caso: no hay stock. No cobramos y le avisamos cuándo vuelve."
    },
    {
      "show": [
        "yes"
      ],
      "flow": "yes",
      "state": {
        "stock": "success",
        "no": "default",
        "notify": "default",
        "pay": "pending"
      },
      "caption": "Con stock: se intenta el cobro",
      "notes": "El camino feliz: con stock, intentamos cobrar la tarjeta o la transferencia."
    },
    {
      "show": [
        "e4"
      ],
      "flow": "e4",
      "state": {
        "pay": "success",
        "ship": "pending"
      },
      "caption": "Cobro aprobado, empieza el envío",
      "notes": "Cobro aprobado, así que el almacén empieza a preparar la caja."
    },
    {
      "show": [
        "e5"
      ],
      "flow": "e5",
      "state": {
        "ship": "success",
        "done": "success"
      },
      "caption": "Entregado",
      "notes": "Y se entrega. Pregunta al público: ¿dónde más podría fallar este proceso?"
    }
  ]
}
