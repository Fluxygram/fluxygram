{
  "$schema": "/schema/v1.json",
  "type": "flow",
  "title": "Una partida de un juego de aventuras",
  "nodes": [
    {
      "id": "start",
      "label": "Nueva partida",
      "kind": "start",
      "icon": "gamepad"
    },
    {
      "id": "explore",
      "label": "Explorar",
      "description": "el calabozo",
      "icon": "map"
    },
    {
      "id": "fight",
      "label": "Combate",
      "description": "aparece un enemigo",
      "icon": "zap"
    },
    {
      "id": "won",
      "label": "¿Ganaste?",
      "kind": "decision"
    },
    {
      "id": "over",
      "label": "Game over",
      "description": "vuelves al último guardado",
      "icon": "repeat"
    },
    {
      "id": "loot",
      "label": "Botín",
      "description": "oro y objetos",
      "icon": "coins"
    },
    {
      "id": "level",
      "label": "Subir de nivel",
      "icon": "up"
    },
    {
      "id": "boss",
      "label": "Jefe final",
      "icon": "flag"
    },
    {
      "id": "victory",
      "label": "Victoria",
      "kind": "end",
      "accent": true,
      "icon": "trophy"
    }
  ],
  "edges": [
    {
      "id": "g1",
      "from": "start",
      "to": "explore"
    },
    {
      "id": "g2",
      "from": "explore",
      "to": "fight"
    },
    {
      "id": "g3",
      "from": "fight",
      "to": "won"
    },
    {
      "id": "gno",
      "from": "won",
      "to": "over",
      "label": "no"
    },
    {
      "id": "gyes",
      "from": "won",
      "to": "loot",
      "label": "sí",
      "carries": "XP"
    },
    {
      "id": "g5",
      "from": "loot",
      "to": "level",
      "carries": "XP"
    },
    {
      "id": "g6",
      "from": "level",
      "to": "boss"
    },
    {
      "id": "g7",
      "from": "boss",
      "to": "victory"
    }
  ],
  "steps": [
    {
      "show": [
        "start"
      ],
      "caption": "Empieza una partida nueva"
    },
    {
      "show": [
        "g1"
      ],
      "flow": "g1",
      "caption": "Exploras el calabozo"
    },
    {
      "show": [
        "g2"
      ],
      "flow": "g2",
      "state": {
        "fight": "pending"
      },
      "caption": "Un enemigo bloquea el camino"
    },
    {
      "show": [
        "g3"
      ],
      "flow": "g3",
      "caption": "El combate decide lo que sigue"
    },
    {
      "show": [
        "gno"
      ],
      "flow": "gno",
      "state": {
        "over": "error",
        "gno": "error"
      },
      "caption": "Si pierdes, vuelves al último guardado"
    },
    {
      "show": [
        "gyes"
      ],
      "flow": "gyes",
      "state": {
        "fight": "success"
      },
      "caption": "Si ganas, te llevas el botín"
    },
    {
      "show": [
        "g5"
      ],
      "flow": "g5",
      "caption": "La experiencia te hace más fuerte"
    },
    {
      "show": [
        "g6"
      ],
      "flow": "g6",
      "state": {
        "boss": "pending"
      },
      "caption": "Listo para el jefe final"
    },
    {
      "show": [
        "g7"
      ],
      "flow": "g7",
      "state": {
        "boss": "success"
      },
      "highlight": [
        "victory"
      ],
      "caption": "¡Victoria!"
    }
  ]
}
