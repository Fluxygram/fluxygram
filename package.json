{
  "name": "fluxygram-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter site dev",
    "build": "pnpm --filter site build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cf": "node scripts/cf.mjs",
    "cf:login": "node scripts/cf.mjs login",
    "preview": "pnpm build && node scripts/cf.mjs dev",
    "deploy": "pnpm build && node scripts/cf.mjs deploy",
    "build:packages": "pnpm --filter @fluxygram/core build && pnpm --filter @fluxygram/element build && pnpm --filter fluxygram build",
    "release": "pnpm build:packages && pnpm publish -r --filter \"@fluxygram/*\" --filter fluxygram --access public --no-git-checks"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp"
    ]
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
